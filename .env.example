# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# === Hardened Backend Env ===
PORT=5000
# Loopback default — LAN/internet cannot reach the API. PaaS sets HOST=0.0.0.0.
HOST=127.0.0.1
# Local TLS (opt-in): serve https directly instead of via Caddy/Nginx.
TLS_CERT_PATH=""
TLS_KEY_PATH=""
NODE_ENV=production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED in production — no defaults, fail-closed. Never commit real values.
JWT_SECRET=""
JWT_EXPIRES=30m

# Auth codes: comma-separated SHA-256 hex of UPPER(TRIM(code)).
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('YOUR-CODE'.toUpperCase().trim()).digest('hex'))"
# REQUIRED in production.
AUTH_CODE_HASHES=""

# === OAuth (Super Security) ===
GITHUB_CLIENT_ID="YOUR_GITHUB_OAUTH_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_OAUTH_SECRET"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_SECRET"
OAUTH_CALLBACK_URL="https://mars-ai-gateway-free.onrender.com/api/auth/oauth"

# === 3-Tier Hack-Proof (all REQUIRED in production) ===
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TIER_HMAC=""
# 2FA TOTP issuer
TOTP_ISSUER="MarsAI"
# 32-byte hex for Tier3 HSM / secureStore (PBKDF2-derived, never single SHA-256)
MASTER_KEY=""
# Comma-separated honey/canary tokens (never commit real values)
HONEY_TOKENS=""
# Comma-separated admin subjects (sub/jti) allowed to POST /api/vault/hsm/rotate
ADMIN_SUBJECTS=""

# === AI Gateway (LLM) limits ===
# Global tokens/min across all keys (cost breaker, LLM10)
GLOBAL_TPM="1000000"
# Upstream LLM timeout ms (fail-fast, no hanging cost)
UPSTREAM_TIMEOUT_MS="25000"
# Redis for multi-instance quota/rate sync (required for >1 instance)
REDIS_URL=""
# KMS: local|aws-kms|gcp-kms (FIPS: use aws/gcp in prod)
KMS_PROVIDER="local"
