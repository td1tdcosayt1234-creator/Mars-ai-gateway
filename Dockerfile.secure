# Hardened Dockerfile - non-root, minimal attack surface, reproducible installs
# 10/10: apk upgrade, no scripts, read-only run, dropped caps (compose/k8s)
FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* ./
RUN apk upgrade --no-cache && \
  if [ -f package-lock.json ]; then npm ci --ignore-scripts; else npm install --ignore-scripts; fi && \
  npm cache clean --force
COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:20-alpine
RUN apk upgrade --no-cache && addgroup -S mars && adduser -S mars -G mars
WORKDIR /app
COPY --from=builder --chown=mars:mars /app/dist ./dist
COPY --from=builder --chown=mars:mars /app/server.js ./server.js
COPY --from=builder --chown=mars:mars /app/server ./server
COPY --from=builder --chown=mars:mars /app/package.json ./package.json
COPY --from=builder --chown=mars:mars /app/node_modules ./node_modules
# Writable data dir for durable JSON (0600 files) — mount persistent disk in prod
RUN mkdir -p /app/data && chown mars:mars /app/data
USER mars
EXPOSE 5000
ENV NODE_ENV=production
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD wget -qO- http://127.0.0.1:5000/api/health || exit 1
# Run read-only where orchestrator allows: --read-only --tmpfs /tmp (see compose/k8s)
CMD ["node","server.js"]
